# Copy to .env and fill in the values you need. Everything except
# LLAMA_PARSE_API_KEY has a working default (see backend/src/core/settings.py).

# Required: get one at https://cloud.llamaindex.ai/
LLAMA_PARSE_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=knowledge_base

# Storage
UPLOAD_DIR=temp_uploads
MODELS_CACHE_DIR=models_cache

# Text splitting
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Embeddings
DENSE_MODEL_NAME=BAAI/bge-m3
SPARSE_MODEL_NAME=prithivida/Splade_PP_en_v1
EMBEDDING_BATCH_SIZE=8
INGESTION_BATCH_SIZE=32
SPARSE_MODEL_THREADS=4

# Reranker (configured but not yet wired into search/chat)
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# llama.cpp
LLAMA_CPP_URL=http://localhost:8080
LLAMA_CPP_MODEL_NAME=gemma-4-E4B-it-Q4_K_M
LLAMA_CONTAINER_NAME=llama-cpp-gpu
LLAMA_IDLE_TIMEOUT_SECONDS=300

# Search
DEFAULT_SEARCH_LIMIT=5
RETRIEVAL_LIMIT=15
PREFETCH_MULTIPLIER=2
